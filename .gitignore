__pycache__/
*.py[cod]

# Re-include release source/docs hidden by the repository-level .gitignore.
!README.md
!**/README.md
!cve_benchmark/data/
!cve_benchmark/data/*.py
!cve_benchmark/prompts/
!cve_benchmark/prompts/*.md
!versim/
!versim/**

# Local data/artifacts supplied separately or generated by replication runs.
/data/
/source_codes/
/advisory-database/
/secrets.env

# Bundled CVE inputs (kept) and locally generated CVE artifacts (ignored).
/cves/00_cve_json/
/cves/31_nopatch/
/cves/diffs/
/cves/*.json
/cves/*.py
/cves/*.md
!/cves/10_dataset_cve_json/
!/cves/20_affected_binaries/
!/cves/30_patch/
!/cves/cve-package.csv

# Bundled archive cache (only the file we ship).
/archive/*
!/archive/version_dates_cache.json

# CVE benchmark outputs.
cve_benchmark/data/_prepare_shards/
cve_benchmark/data/selected.json
cve_benchmark/data/ground_truth.json
cve_benchmark/data/decoys.json
cve_benchmark/filled_prompts/
cve_benchmark/logs/
cve_benchmark/outputs/
cve_benchmark/response/
cve_benchmark/results/
cve_benchmark/stripped_binaries/

# Version-similarity outputs and third-party model artifacts.
versim/malconv/upstream/
versim/malconv/manifest*.json
versim/malconv/embeddings*.npz
versim/malconv/similarity*.npy
versim/malconv/similarity*.json
versim/malconv/tiers/
versim/tlsh/hashes*.json
versim/tlsh/meta*.json
versim/tlsh/distances*.npy

# Bayesian generated artifacts.
bayesian_rep/.cache/
bayesian_rep/.mplconfig/
bayesian_rep/release_pairs*.csv
bayesian_rep/dataset_build_report.json
bayesian_rep/tlsh_transform_report.json
bayesian_rep/normalized_file_change/*/model_input.csv
bayesian_rep/normalized_file_change/*/model_metadata.json
bayesian_rep/normalized_file_change/*/mcmc_samples.nc
bayesian_rep/normalized_file_change/*/summary.csv
